import cv2

# Read image
img = cv2.imread(r"C:\Users\anton\Downloads\sanjuu.jpg")

# Convert to grayscale
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

# Draw two rectangles
cv2.rectangle(gray, (100, 100), (180, 150), 0, 3)
cv2.rectangle(gray, (250, 100), (330, 150), 0, 3)

# Draw one circle
cv2.circle(gray, (215, 250), 50, 0, 3)

# Display
cv2.imshow("Grayscale Image", gray)

cv2.waitKey(0)
cv2.destroyAllWindows()
